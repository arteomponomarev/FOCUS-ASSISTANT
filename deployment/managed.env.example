# Encrypt the filled file with systemd-creds, following the managed cloud runbook.
# The deploy script supplies FOCUS_API_IMAGE from the approved GitHub receipt.
FOCUS_PUBLIC_HOSTNAME=focus.example.invalid
FOCUS_PG_CA_FILE=/etc/focus/postgres-ca.crt
# Set FOCUS_PROXY_IMAGE to docker.io/library/caddy@sha256:<reviewed digest>.
# Choose the provider's private hostname and direct database port.
# Enter each Npgsql DSN as a single-quoted Compose value, including its role password.
# Example shape: Host=PRIVATE_HOST;Port=25060;Database=focus_production;Username=ROLE;Password=VALUE;SSL Mode=VerifyFull;Root Certificate=/etc/focus/postgres-ca.crt;Maximum Pool Size=LIMIT
# FOCUS_DB_CONNECTION uses focus_runtime and a pool limit of 8.
# FOCUS_DB_MIGRATION_CONNECTION uses focus_migrate and a pool limit of 2.
