{$FOCUS_PUBLIC_HOSTNAME} {
	encode zstd gzip

	@api path /api /api/* /health /health/*
	handle @api {
		reverse_proxy api:8080
	}

	handle /assets/* {
		root * /srv/focus/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/focus/web
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
